{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stead.example/packages/event-schemas/platform/platform-event-v0.1.schema.json",
  "title": "Stead CloudEvent data",
  "type": "object",
  "required": ["schema_version", "organization_id", "security_domain_id", "container", "effective_security_label", "actor_context", "resource", "idempotency_key"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "organization_id": {"$ref": "../../../specs/work-graph-profile/owgp-v0.1.schema.json#/$defs/UuidV7"},
    "security_domain_id": {"type": "string"},
    "container": {"$ref": "../../../specs/work-graph-profile/owgp-v0.1.schema.json#/$defs/ContainerRef"},
    "capability_context": {
      "type": "object",
      "description": "Optional, authorization-filtered capability context; omitted when irrelevant or not visible.",
      "required": ["active"],
      "properties": {
        "active": {"type": "array", "items": {"enum": ["work", "docs", "scm", "code_review", "ci", "packages", "releases", "deployments"]}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "effective_security_label": {"$ref": "../../../specs/work-graph-profile/owgp-v0.1.schema.json#/$defs/SecurityLabelValue"},
    "actor_context": {"$ref": "../common/actor-context/actor-context-v0.1.schema.json"},
    "resource": {"$ref": "../../../specs/work-graph-profile/owgp-v0.1.schema.json#/$defs/ResourceRef"},
    "idempotency_key": {"type": "string", "minLength": 8},
    "changed_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
