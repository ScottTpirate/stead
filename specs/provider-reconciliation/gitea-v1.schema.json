{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stead.example/specs/provider-reconciliation/gitea-v1.schema.json",
  "title": "Stead Gitea reconciliation ownership and security contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "contract_id",
    "owner",
    "decision_record",
    "activation_gate",
    "requirements",
    "authority",
    "field_classes",
    "authorization",
    "provider_behavior",
    "persistence",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "governed_by_adr_0009" },
    "contract_id": { "const": "P-SCM-RECONCILIATION-GITEA-V1" },
    "owner": { "const": "WS-03" },
    "decision_record": {
      "const": "docs/adr/0009-gitea-provider-reconciliation-precedence-and-conflict-handling.md"
    },
    "activation_gate": { "const": "ADR-CAND-008_ACCEPTED_AT_EXACT_IMMUTABLE_SHA" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_state",
        "provider_owned_state",
        "provider_permission",
        "webhook",
        "ordinary_ui_read_source",
        "ordinary_ui_synchronous_provider_calls"
      ],
      "properties": {
        "canonical_state": { "const": "module_owned_postgresql" },
        "provider_owned_state": { "const": "documented_gitea_api_or_git" },
        "provider_permission": { "const": "enforcement_not_authority" },
        "webhook": { "const": "authenticated_dirty_notification_not_canonical_delta" },
        "ordinary_ui_read_source": { "const": "local_rebuildable_postgresql_projection" },
        "ordinary_ui_synchronous_provider_calls": { "const": 0 }
      }
    },
    "field_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_only",
        "provider_content",
        "mapped_value",
        "managed_configuration",
        "central_security",
        "provider_identity",
        "derived_projection"
      ],
      "properties": {
        "canonical_only": { "$ref": "#/$defs/fieldClass" },
        "provider_content": { "$ref": "#/$defs/fieldClass" },
        "mapped_value": { "$ref": "#/$defs/fieldClass" },
        "managed_configuration": { "$ref": "#/$defs/fieldClass" },
        "central_security": { "$ref": "#/$defs/fieldClass" },
        "provider_identity": { "$ref": "#/$defs/fieldClass" },
        "derived_projection": { "$ref": "#/$defs/fieldClass" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_read_scope", "effect_permit", "canonical_acceptance"],
      "properties": {
        "provider_read_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "owner",
            "consumer",
            "decision_cardinality",
            "reusable",
            "renewable",
            "transferable",
            "durable_effect_permits_per_eligible_call_or_page",
            "eligible_calls",
            "required_bindings",
            "bounded_dimensions",
            "validation_points"
          ],
          "properties": {
            "type": { "const": "ProviderAuthorizationScope" },
            "owner": { "const": "WS-06" },
            "consumer": { "const": "WS-03" },
            "decision_cardinality": { "const": "one_fresh_per_bounded_logical_provider_read_plan" },
            "reusable": { "const": false },
            "renewable": { "const": false },
            "transferable": { "const": false },
            "durable_effect_permits_per_eligible_call_or_page": { "const": 0 },
            "eligible_calls": {
              "$ref": "#/$defs/nonEmptyStringSet",
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "enum": [
                  "pagination_read",
                  "snapshot_read",
                  "bounded_verification_read",
                  "compatibility_profile_safe_idempotent_read_retry"
                ]
              }
            },
            "required_bindings": {
              "$ref": "#/$defs/nonEmptyStringSet",
              "type": "array",
              "minItems": 19,
              "maxItems": 19,
              "items": {
                "enum": [
                  "scope_id",
                  "logical_operation_id",
                  "acting_service_principal",
                  "initiating_principal_or_explicit_system_initiator",
                  "organization_id",
                  "security_domain_id",
                  "canonical_container",
                  "closed_resource_set_or_container_inventory_scope",
                  "provider_installation_id",
                  "provider_api_path",
                  "provider_resource_key_when_resource_specific",
                  "reconciliation_generation",
                  "allowed_operation_class",
                  "closed_call_plan",
                  "activation_snapshot",
                  "authorization_consistency_vector",
                  "compatibility_profile_id_version_and_schema_digest",
                  "original_deadline",
                  "immutable_earliest_bound_expiry"
                ]
              }
            },
            "bounded_dimensions": {
              "$ref": "#/$defs/nonEmptyStringSet",
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": { "enum": ["attempts", "calls", "pages", "items", "response_bytes"] }
            },
            "validation_points": {
              "$ref": "#/$defs/nonEmptyStringSet",
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "enum": ["before_each_provider_call", "before_local_outcome_commit"] }
            }
          }
        },
        "effect_permit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "owner", "durability", "required_for"],
          "properties": {
            "type": { "const": "AuthorizationEffectPermit" },
            "owner": { "const": "WS-06" },
            "durability": { "const": "durable_one_use_per_effect" },
            "required_for": {
              "$ref": "#/$defs/nonEmptyStringSet",
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "enum": [
                  "provider_mutation",
                  "credential_issuance",
                  "direct_git_or_protocol_access",
                  "export_or_download",
                  "non_idempotent_call",
                  "ambiguous_external_effect",
                  "operation_outliving_logical_request_or_job"
                ]
              }
            }
          }
        },
        "canonical_acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_read_scope_authorizes_acceptance",
            "authorization",
            "required_fences"
          ],
          "properties": {
            "provider_read_scope_authorizes_acceptance": { "const": false },
            "authorization": { "const": "fresh_effective_principal_central_decision_for_exact_delta" },
            "required_fences": {
              "$ref": "#/$defs/nonEmptyStringSet",
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "enum": [
                  "activation",
                  "authorization",
                  "provider_enforcement",
                  "resource",
                  "operation",
                  "optimistic_canonical_owner_revision"
                ]
              }
            }
          }
        }
      }
    },
    "provider_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconciliation_outcomes",
        "provider_originated_acceptance",
        "ambiguous_effect_state",
        "blind_retry",
        "network_io_inside_postgresql_transaction",
        "general_project_creates_code_repository"
      ],
      "properties": {
        "reconciliation_outcomes": {
          "$ref": "#/$defs/nonEmptyStringSet",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "enum": ["in_sync", "accept", "reset", "quarantine"] }
        },
        "provider_originated_acceptance": { "const": "fresh_authorization_and_final_fence" },
        "ambiguous_effect_state": { "const": "reconciling_until_terminal_proof" },
        "blind_retry": { "const": false },
        "network_io_inside_postgresql_transaction": { "const": false },
        "general_project_creates_code_repository": { "const": false }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconciliation_state_owner",
        "canonical_write_owner",
        "core_outbox_owner",
        "audit_schema_owner",
        "audit_materialization_owner",
        "deployment_operations_owner",
        "projections_rebuildable",
        "browser_direct_provider_calls"
      ],
      "properties": {
        "reconciliation_state_owner": { "const": "WS-03" },
        "canonical_write_owner": { "const": "WS-02" },
        "core_outbox_owner": { "const": "WS-02" },
        "audit_schema_owner": { "const": "WS-01" },
        "audit_materialization_owner": { "const": "WS-07" },
        "deployment_operations_owner": { "const": "WS-12" },
        "projections_rebuildable": { "const": true },
        "browser_direct_provider_calls": { "const": 0 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_issue", "runtime_test_location", "deferred_runtime_concerns"],
      "properties": {
        "runtime_issue": { "const": "STEAD-P1-003" },
        "runtime_test_location": { "const": "tests/contract/gitea" },
        "deferred_runtime_concerns": {
          "$ref": "#/$defs/nonEmptyStringSet",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "enum": [
              "pagination_bounds",
              "reconciliation_state_transitions",
              "provider_call_behavior",
              "effect_permit_behavior"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "fieldClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["examples", "provider_change"],
      "properties": {
        "examples": { "$ref": "#/$defs/nonEmptyStringSet" },
        "provider_change": { "type": "string", "minLength": 1 }
      }
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
