{
  "domain_id": "stead-local-development",
  "version": "1.0.0",
  "policy_purpose": "starter_reference",
  "scope": {
    "summary": "Explicit local-development metadata policy for synthetic-only Stead data.",
    "limitations": [
      "Not a production deployment or regulated assurance policy.",
      "Only local authenticated User metadata operations are supported; unsupported labels, effects, and principals deny."
    ]
  },
  "label_profile_ceilings": {
    "commercial": {
      "profile_version": "1.0.0",
      "classification_ceiling": "restricted"
    }
  },
  "disclosure_revocation_mode": "request_boundary",
  "trusted_attribute_authorities": [
    "stead_local_identity"
  ],
  "approved_profile_bridges": [],
  "allowed_integrations": [
    "gitea",
    "oidc",
    "scim",
    "smtp",
    "approved_webhook"
  ],
  "allowed_notification_channels": [
    "in_app",
    "email",
    "approved_webhook"
  ],
  "storage": {
    "providers": [
      "filesystem",
      "s3",
      "azure",
      "gcs"
    ],
    "encryption_profile": "commercial-managed",
    "residency": [
      "configured_regions"
    ]
  },
  "backup": {
    "enabled": true,
    "domains": [
      "commercial-backup"
    ],
    "encryption_profile": "commercial-backup-managed"
  },
  "runner": {
    "pools": [
      "commercial-ephemeral"
    ],
    "ephemeral": true,
    "allowed_images": [
      "signed_approved"
    ]
  },
  "network": {
    "zones": [
      "loopback"
    ],
    "egress_policy": "allowlisted"
  },
  "assurance": {
    "policy_signature_threshold": 1,
    "distinct_signing_custodians": false,
    "trust_recovery_approval_threshold": 1,
    "distinct_trust_recovery_approvers": false,
    "lowering_approval_threshold": 1,
    "distinct_lowering_approvers": true,
    "human_lowering_approvers_required": false,
    "approved_cryptographic_boundary": "deployment_approved_standard",
    "validated_cryptographic_module_required": false,
    "evidence_profile": "baseline"
  }
}

