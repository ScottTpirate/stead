{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stead.dev/schemas/performance/evidence-v1.schema.json",
  "title": "Stead performance measurement evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "schema_version", "evidence_id", "evidence_kind", "source",
    "dataset", "scenario_id", "provenance", "counts", "timings_ms", "sizes",
    "web_vitals", "go_microbenchmark", "scaling_trials", "raw_samples", "raw_samples_sha256",
    "request_traces", "request_traces_sha256", "telemetry"
  ],
  "properties": {
    "artifact_type": { "const": "performance_measurement" },
    "schema_version": { "const": "1.0" },
    "evidence_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "evidence_kind": { "enum": ["measurement", "test_fixture"] },
    "source": { "$ref": "#/$defs/source" },
    "dataset": { "$ref": "#/$defs/datasetReference" },
    "scenario_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["runner", "runner_version", "command", "started_at", "ended_at"],
      "properties": {
        "runner": { "type": "string", "minLength": 1, "maxLength": 120 },
        "runner_version": { "type": "string", "minLength": 1, "maxLength": 120 },
        "command": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" }
      }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "timings_ms": { "$ref": "#/$defs/timingSummary" },
    "sizes": {
      "type": "object", "additionalProperties": false,
      "required": ["response_bytes", "eager_javascript_gzip_bytes", "lazy_javascript_gzip_bytes", "lazy_javascript_chunks", "frontend_baseline", "frontend_bundle_graph"],
      "properties": {
        "response_bytes": { "type": "integer", "minimum": 0 },
        "eager_javascript_gzip_bytes": { "type": "integer", "minimum": 0, "maximum": 256000 },
        "lazy_javascript_gzip_bytes": { "type": "integer", "minimum": 0 },
        "lazy_javascript_chunks": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "capability", "entry_path", "file_paths", "uncompressed_bytes", "gzip_bytes"],
            "properties": {
              "name": { "$ref": "#/$defs/capability" },
              "capability": { "$ref": "#/$defs/capability" },
              "entry_path": { "$ref": "#/$defs/bundlePath" },
              "file_paths": {
                "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
                "items": { "$ref": "#/$defs/bundlePath" }
              },
              "uncompressed_bytes": { "type": "integer", "minimum": 1 },
              "gzip_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "frontend_baseline": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["baseline_id", "baseline_gzip_bytes", "current_gzip_bytes", "delta_gzip_bytes", "lazy_chunk_delta_gzip_bytes"],
          "properties": {
            "baseline_id": { "type": "string", "minLength": 1 },
            "baseline_gzip_bytes": { "type": "integer" },
            "current_gzip_bytes": { "type": "integer" },
            "delta_gzip_bytes": { "type": "integer" },
            "lazy_chunk_delta_gzip_bytes": { "type": "integer" }
          }
        },
        "frontend_bundle_graph": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["eager_entry_path", "capability_entries", "files"],
          "properties": {
            "eager_entry_path": { "$ref": "#/$defs/bundlePath" },
            "capability_entries": {
              "type": "array", "minItems": 6, "maxItems": 6,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["capability", "path"],
                "properties": {
                  "capability": { "$ref": "#/$defs/capability" },
                  "path": { "$ref": "#/$defs/bundlePath" }
                }
              }
            },
            "files": {
              "type": "array", "minItems": 7, "maxItems": 256,
              "items": { "$ref": "#/$defs/bundleFile" }
            }
          }
        }
      }
    },
    "web_vitals": {
      "type": "object", "additionalProperties": false,
      "required": ["lcp_ms", "inp_ms", "cls"],
      "properties": {
        "lcp_ms": { "type": "number", "minimum": 0 },
        "inp_ms": { "type": "number", "minimum": 0 },
        "cls": { "type": "number", "minimum": 0 }
      }
    },
    "go_microbenchmark": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["nanoseconds_per_operation", "allocations_per_operation", "bytes_per_operation"],
      "properties": {
        "nanoseconds_per_operation": { "type": "number", "exclusiveMinimum": 0 },
        "allocations_per_operation": { "type": "number", "minimum": 0 },
        "bytes_per_operation": { "type": "number", "minimum": 0 }
      }
    },
    "scaling_trials": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["result_count", "sql_queries", "postgres_writes", "openfga_calls", "policy_calls", "provider_calls", "logical_audit_operations"],
        "properties": {
          "result_count": { "type": "integer", "minimum": 0 },
          "sql_queries": { "type": "integer", "minimum": 0 },
          "postgres_writes": { "type": "integer", "minimum": 0 },
          "openfga_calls": { "type": "integer", "minimum": 0 },
          "policy_calls": { "type": "integer", "minimum": 0 },
          "provider_calls": { "type": "integer", "minimum": 0 },
          "logical_audit_operations": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "raw_samples": {
      "type": "object", "additionalProperties": false,
      "required": ["timings_ms", "counts", "response_bytes", "web_vitals"],
      "properties": {
        "timings_ms": {
          "type": "object", "additionalProperties": false,
          "required": ["latency", "sql", "openfga", "policy", "provider", "projection_lag"],
          "properties": {
            "latency": { "$ref": "#/$defs/sampleSeries" },
            "sql": { "$ref": "#/$defs/sampleSeries" },
            "openfga": { "$ref": "#/$defs/sampleSeries" },
            "policy": { "$ref": "#/$defs/sampleSeries" },
            "provider": { "$ref": "#/$defs/sampleSeries" },
            "projection_lag": { "$ref": "#/$defs/sampleSeries" }
          }
        },
        "counts": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/counts" } },
        "response_bytes": { "$ref": "#/$defs/integerSampleSeries" },
        "web_vitals": {
          "type": "object", "additionalProperties": false,
          "required": ["lcp_ms", "inp_ms", "cls"],
          "properties": {
            "lcp_ms": { "$ref": "#/$defs/sampleSeries" },
            "inp_ms": { "$ref": "#/$defs/sampleSeries" },
            "cls": { "$ref": "#/$defs/sampleSeries" }
          }
        }
      }
    },
    "raw_samples_sha256": { "$ref": "#/$defs/sha256" },
    "request_traces": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["trace_id_hash", "sample_index", "sample_started_monotonic_ns", "events"],
        "properties": {
          "trace_id_hash": { "$ref": "#/$defs/sha256" },
          "sample_index": { "type": "integer", "minimum": 0 },
          "sample_started_monotonic_ns": { "type": "integer", "minimum": 0 },
          "events": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["type", "monotonic_ns", "origin", "route_template"],
              "properties": {
                "type": {
                  "enum": [
                    "browser_request", "sql_query", "postgres_write", "openfga_call",
                    "policy_call", "provider_call", "nats_wait", "logical_audit_operation",
                    "authorization_cache_hit", "authoritative_commit", "response_sent", "relay_started"
                  ]
                },
                "monotonic_ns": { "type": "integer", "minimum": 0 },
                "origin": { "enum": ["stead_api", "provider", "internal", null] },
                "route_template": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
                "write_role": { "enum": ["authoritative_state", "transactional_outbox", "aggregate_audit", null] },
                "transaction_id_hash": {
                  "oneOf": [
                    { "$ref": "#/$defs/sha256" },
                    { "type": "null" }
                  ]
                },
                "outbox_event_id_hash": {
                  "oneOf": [
                    { "$ref": "#/$defs/sha256" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "request_traces_sha256": { "$ref": "#/$defs/sha256" },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ruleset_id", "records", "records_sha256", "normalized_key_count",
        "normalized_string_value_count", "forbidden_key_hits", "forbidden_value_hits",
        "canary_value_hits", "protected_content_retained"
      ],
      "properties": {
        "ruleset_id": { "type": "string", "minLength": 1 },
        "records": {
          "type": "array", "minItems": 1, "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["metric", "value", "attributes"],
            "properties": {
              "metric": { "type": "string", "minLength": 1, "maxLength": 160 },
              "value": { "type": "number" },
              "attributes": {
                "type": "object", "maxProperties": 32,
                "propertyNames": { "type": "string", "minLength": 1, "maxLength": 120 },
                "additionalProperties": {
                  "anyOf": [
                    { "type": "string", "maxLength": 1024 },
                    { "type": "number" },
                    { "type": "boolean" }
                  ]
                }
              }
            }
          }
        },
        "records_sha256": { "$ref": "#/$defs/sha256" },
        "normalized_key_count": { "type": "integer", "minimum": 0 },
        "normalized_string_value_count": { "type": "integer", "minimum": 0 },
        "forbidden_key_hits": { "const": 0 },
        "forbidden_value_hits": { "const": 0 },
        "canary_value_hits": { "const": 0 },
        "protected_content_retained": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capability": { "enum": ["docs_editor", "code", "delivery", "administration", "migration", "analytics"] },
    "bundlePath": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^(artifacts/performance|packages/test-fixtures/harness/performance)/[A-Za-z0-9._/-]+\\.js$"
    },
    "bundleFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "uncompressed_bytes", "gzip_bytes", "imports", "dynamic_imports"],
      "properties": {
        "path": { "$ref": "#/$defs/bundlePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "uncompressed_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "gzip_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "imports": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": { "$ref": "#/$defs/bundlePath" }
        },
        "dynamic_imports": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "$ref": "#/$defs/bundlePath" }
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "dirty", "recorded_at", "tool_versions"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "tool_versions": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 120 },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "datasetReference": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "sha256"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "browser_requests", "sql_queries", "postgres_writes", "openfga_calls",
        "policy_calls", "provider_calls", "nats_waits", "logical_audit_operations",
        "browser_forbidden_origin_requests", "authorization_cache_hits"
      ],
      "properties": {
        "browser_requests": { "type": "integer", "minimum": 0 },
        "sql_queries": { "type": "integer", "minimum": 0 },
        "postgres_writes": { "type": "integer", "minimum": 0 },
        "openfga_calls": { "type": "integer", "minimum": 0 },
        "policy_calls": { "type": "integer", "minimum": 0 },
        "provider_calls": { "type": "integer", "minimum": 0 },
        "nats_waits": { "const": 0 },
        "logical_audit_operations": { "type": "integer", "minimum": 0 },
        "browser_forbidden_origin_requests": { "const": 0 },
        "authorization_cache_hits": { "const": 0 }
      }
    },
    "percentiles": {
      "type": "object", "additionalProperties": false,
      "required": ["p50", "p95", "p99"],
      "properties": {
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 }
      }
    },
    "timingSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["latency", "sql", "openfga", "policy", "provider", "projection_lag"],
      "properties": {
        "latency": { "$ref": "#/$defs/percentiles" },
        "sql": { "$ref": "#/$defs/percentiles" },
        "openfga": { "$ref": "#/$defs/percentiles" },
        "policy": { "$ref": "#/$defs/percentiles" },
        "provider": { "$ref": "#/$defs/percentiles" },
        "projection_lag": { "$ref": "#/$defs/percentiles" }
      }
    },
    "sampleSeries": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "number", "minimum": 0 } },
    "integerSampleSeries": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "integer", "minimum": 0 } }
  }
}
