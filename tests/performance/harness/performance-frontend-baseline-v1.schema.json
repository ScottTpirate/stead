{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stead.dev/schemas/performance/frontend-baseline-v1.schema.json",
  "title": "Stead trusted frontend bundle baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "schema_version", "baseline_id", "scope", "source_revision",
    "source_pr", "ci_run", "source_web_tree_oid", "package_lock_sha256",
    "dataset_manifest_id", "dataset_sha256", "measured_command", "build_runner",
    "measurement_tool", "budget_bytes_gzip", "eager_javascript_bytes_gzip",
    "measured_files", "lazy_capability_chunks_excluded", "mature_devlane_interface_complete",
    "perf_005_complete", "interpretation"
  ],
  "properties": {
    "artifact_type": { "const": "frontend_bundle_baseline" },
    "schema_version": { "const": "1.0" },
    "baseline_id": { "type": "string", "minLength": 1 },
    "scope": { "const": "minimal-foundation-shell-only" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_pr": { "type": "string", "format": "uri" },
    "ci_run": { "type": "string", "format": "uri" },
    "source_web_tree_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package_lock_sha256": { "$ref": "#/$defs/sha256" },
    "dataset_manifest_id": { "type": "string", "minLength": 1 },
    "dataset_sha256": { "$ref": "#/$defs/sha256" },
    "measured_command": { "type": "string", "minLength": 1 },
    "build_runner": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "scripts/run_pinned_node.sh" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "measurement_tool": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "scripts/validate_web_bundle.mjs" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "budget_bytes_gzip": { "const": 256000 },
    "eager_javascript_bytes_gzip": { "const": 60808 },
    "measured_files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file", "file_sha256", "uncompressed_bytes", "gzip_bytes"],
        "properties": {
          "file": { "type": "string", "pattern": "^assets/[A-Za-z0-9._-]+\\.js$" },
          "file_sha256": { "$ref": "#/$defs/sha256" },
          "uncompressed_bytes": { "type": "integer", "minimum": 1 },
          "gzip_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "lazy_capability_chunks_excluded": { "const": true },
    "mature_devlane_interface_complete": { "const": false },
    "perf_005_complete": { "const": false },
    "interpretation": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
